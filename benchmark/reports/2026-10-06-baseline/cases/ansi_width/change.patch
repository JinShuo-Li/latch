 """Terminal display width for short status cells."""
 
+import re
+import unicodedata
+
+_ANSI_ESCAPE = re.compile(
+    r"""
+    \x1b
+    (?:
+        \[[0-?]*[ -/]*[@-~]              # CSI sequence (colors, cursor moves)
+      | \][^\x07\x1b]*(?:\x07|\x1b\\)    # OSC sequence (hyperlinks, titles)
+      | [@-Z\\-_]                        # two-character escape
+    )
+    """,
+    re.VERBOSE,
+)
+
+# Categories that occupy no columns: combining marks and format characters.
+_ZERO_WIDTH_CATEGORIES = frozenset(("Mn", "Me", "Cf"))
+# East Asian width classes that occupy two columns.
+_WIDE_WIDTH_CLASSES = frozenset(("W", "F"))
+
 
 def display_width(text):
-    return len(text)
+    """Return the number of terminal columns needed to print *text*.
+
+    ANSI escape sequences take no columns, combining marks attach to the
+    preceding character, and East Asian wide/fullwidth characters occupy two.
+    """
+    width = 0
+    for char in _ANSI_ESCAPE.sub("", text):
+        if unicodedata.combining(char) or unicodedata.category(char) in _ZERO_WIDTH_CATEGORIES:
+            continue
+        width += 2 if unicodedata.east_asian_width(char) in _WIDE_WIDTH_CLASSES else 1
+    return width
