 """ZIP document import."""
 
+import re
+import stat
 import zipfile
 from pathlib import Path
 
+_DRIVE = re.compile(r"^[A-Za-z]:")
+
+
+def _safe_parts(name):
+    """Split an archive member name into safe relative parts.
+
+    Raises ValueError for absolute paths, traversal, or names that cannot be
+    treated as a plain relative path.
+    """
+    if not name or name.startswith("/") or "\\" in name or _DRIVE.match(name):
+        raise ValueError(f"unsafe archive member: {name!r}")
+    parts = [part for part in name.split("/") if part not in ("", ".")]
+    if not parts or any(part == ".." for part in parts):
+        raise ValueError(f"unsafe archive member: {name!r}")
+    return parts
+
 
 def extract_archive(archive, destination):
     destination = Path(destination)
