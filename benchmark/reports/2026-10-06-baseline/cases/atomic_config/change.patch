@@ -0,0 +1,78 @@
+"""Ad-hoc behavioural check for config_store (not part of the visible suite)."""
+
+import json
+import os
+import tempfile
+from pathlib import Path
+
+from config_store import ConfigError, read_config, write_config
+
+with tempfile.TemporaryDirectory() as d:
+    path = Path(d) / "settings.json"
+    bak = path.with_name(path.name + ".bak")
+
+    # first write: no live file, no backup, live created atomically (no temp litter)
+    write_config(path, {"port": 8080})
+    assert json.loads(path.read_text()) == {"port": 8080}
+    assert not bak.exists()
+    assert [p.name for p in Path(d).iterdir()] == ["settings.json"]
+    mask = os.umask(0)
+    os.umask(mask)
+    assert oct(path.stat().st_mode & 0o777)[-3:] == oct(0o666 & ~mask)[-3:]  # no chmod surprise
+
+    # second write: previous valid config preserved as .bak
+    write_config(path, {"port": 9090, "host": "x"})
+    assert json.loads(path.read_text()) == {"port": 9090, "host": "x"}
+    assert json.loads(bak.read_text()) == {"port": 8080}
+
+    # invalid input: TypeError, no file touched, backup intact
+    for bad in [{"bad": {1}}, object(), [1, 2], "text"]:
+        try:
+            write_config(path, bad)
+        except TypeError:
+            pass
+        else:
+            raise AssertionError(f"expected TypeError for {bad!r}")
+    assert json.loads(path.read_text()) == {"port": 9090, "host": "x"}
+    assert json.loads(bak.read_text()) == {"port": 8080}
+    assert sorted(p.name for p in Path(d).iterdir()) == ["settings.json", "settings.json.bak"]
+
+    # corrupt live file, valid backup -> read recovers and repairs live
+    path.write_text("{not json")
+    assert read_config(path) == {"port": 8080}
+    assert json.loads(path.read_text()) == {"port": 8080}
+
+    # corrupt live + valid backup on a fresh pair, live not a JSON object
+    path.write_text('["list"]')
+    assert read_config(path) == {"port": 8080}
+
+    # corrupt live + no usable backup -> ConfigError
+    bak.unlink()
+    path.write_text("{nope")
+    try:
+        read_config(path)
+    except ConfigError:
+        pass
+    else:
+        raise AssertionError("expected ConfigError with both copies bad")
+
+    # missing live + valid backup -> recovered
+    path.unlink()
+    write_config(path, {"a": 1})
+    write_config(path, {"a": 2})          # bak := {"a": 1}
+    path.unlink()
+    assert read_config(path) == {"a": 1}
+
+    # corrupt live must not clobber a good backup on the next write
+    write_config(path, {"a": 3})          # live {"a":3}, bak {"a":1}
+    backup_before = bak.read_bytes()
+    path.write_text("{broken")
+    write_config(path, {"a": 4})
+    assert bak.read_bytes() == backup_before, "good backup was overwritten"
+    assert read_config(path) == {"a": 4}
+
+    # non-mapping JSON in live is rejected, backup is the fallback
+    path.write_text("42")
+    assert read_config(path) == {"a": 1}
+
+print("all behavioural checks passed")
