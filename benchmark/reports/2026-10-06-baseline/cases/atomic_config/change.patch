 """Daemon JSON configuration with backup."""
 
 import json
+import os
+import tempfile
+from collections.abc import Mapping
 from pathlib import Path
 
 
+class ConfigError(ValueError):
+    """Raised when neither the live file nor the backup holds valid settings."""
+
+
+def _backup_path(path):
+    return path.with_name(path.name + ".bak")
+
+
+def _atomic_write(path, content):
+    """Replace path with content, never leaving a partially written file."""
+    try:
+        mode = os.stat(path).st_mode & 0o777
+    except OSError:
+        mask = os.umask(0)
+        os.umask(mask)
+        mode = 0o666 & ~mask
+    fd, tmp_name = tempfile.mkstemp(
+        dir=path.parent, prefix=path.name + ".", suffix=".tmp"
+    )
+    tmp = Path(tmp_name)
+    try:
+        with os.fdopen(fd, "wb") as handle:
+            handle.write(content)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.chmod(tmp, mode)
+        os.replace(tmp, path)
+    except BaseException:
+        tmp.unlink(missing_ok=True)
+        raise
+
+
+def _parse(text, source):
+    try:
+        data = json.loads(text)
+    except ValueError as exc:
+        raise ValueError(f"{source} is not valid JSON: {exc}") from exc
+    if not isinstance(data, Mapping):
+        raise ValueError(f"{source} does not contain a JSON object")
+    return data
+
