+                    )
+                if state.get(dependency) != "done":
+                    state[dependency] = "visiting"
+                    path.append(dependency)
+                    stack.append((dependency, iter(tasks[dependency])))
+                    break
+            else:
+                state[current] = "done"
+                stack.pop()
+                path.pop()
+
+
+def schedule(tasks, runner):
+    _validate(tasks)
+
+    completed = []
+    done = set()
+    for _ in tasks:
+        for name, dependencies in tasks.items():
+            if name in done:
+                continue
+            if all(dependency in done for dependency in dependencies):
+                runner(name)
+                done.add(name)
+                completed.append(name)
