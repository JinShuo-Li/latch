+    state = {}  # name -> "visiting" while on the current path, "done" once cleared
+    for name in tasks:
+        if state.get(name) == "done":
+            continue
+        path = [name]
+        stack = [(name, iter(tasks[name]))]
+        state[name] = "visiting"
+        while stack:
+            current, remaining = stack[-1]
+            for dependency in remaining:
+                if state.get(dependency) == "visiting":
+                    raise ValueError(
