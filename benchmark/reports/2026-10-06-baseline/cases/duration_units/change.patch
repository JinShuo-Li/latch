 """Scheduler duration parser returning milliseconds."""
 
+import re
+
+_DURATION_RE = re.compile(r"\A(\d+)(ms|s|m|h)\Z")
+
+_UNIT_FACTORS = {
+    "ms": 1,
+    "s": 1000,
+    "m": 60000,
+    "h": 3600000,
+}
+
 
 def parse_duration(value):
-    for unit, factor in (("s", 1000), ("m", 60000), ("h", 3600000), ("ms", 1)):
-        if unit in value:
-            return int(value.replace(unit, "", 1)) * factor
-    raise ValueError("unknown duration")
+    """Parse a duration such as ``250ms``, ``2s``, ``3m`` or ``1h``.
+
+    Returns the duration as an integer number of milliseconds. Raises
+    ``ValueError`` for anything that is not a non-negative whole number
+    followed by one of the supported units.
+    """
+    if not isinstance(value, str):
+        raise ValueError("unknown duration")
+    match = _DURATION_RE.match(value)
+    if match is None:
+        raise ValueError("unknown duration")
+    amount, unit = match.groups()
+    return int(amount) * _UNIT_FACTORS[unit]
