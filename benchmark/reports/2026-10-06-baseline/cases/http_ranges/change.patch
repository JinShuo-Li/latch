--- a/ranges.py
+++ b/ranges.py
@@ -2,12 +2,55 @@
 
 
 def serve_range(data, header):
+    """Serve a single byte range of ``data``.
+
+    Returns ``(status, body, content_range)``.  ``header`` is the raw value of
+    the ``Range`` request header (or ``None`` when absent).  Only a single
+    ``bytes`` range is supported; malformed and multi-range headers raise
+    ``ValueError``.
+    """
+    total = len(data)
     if not header:
         return 200, data, None
     if not header.startswith("bytes="):
-        raise ValueError("invalid range")
-    start, end = header[6:].split("-", 1)
-    start = int(start or 0)
-    end = int(end or len(data))
-    body = data[start:end]
-    return 206, body, f"bytes {start}-{end}/{len(data)}"
+        raise ValueError("unsupported range unit")
+    spec = header[len("bytes="):].strip()
+    if not spec:
+        raise ValueError("empty range spec")
+    if "," in spec:
+        raise ValueError("multiple ranges are not supported")
+    if spec.count("-") != 1:
+        raise ValueError("malformed range spec")
+
+    first, last = spec.split("-")
+    first, last = first.strip(), last.strip()
+
+    if not first:
+        # Suffix range: the last N bytes of the resource.
+        if not last.isdigit():
+            raise ValueError("malformed suffix range")
+        length = int(last)
+        if length == 0:
+            return 416, b"", None
+        start = max(0, total - length)
+        end = total - 1
+    else:
+        if not first.isdigit():
+            raise ValueError("malformed range start")
+        start = int(first)
+        if not last:
+            end = total - 1
+        else:
+            if not last.isdigit():
+                raise ValueError("malformed range end")
+            end = int(last)
+        if end < start:
+            return 416, b"", None
+        # Clamp an oversized end to the last available byte.
+        end = min(end, total - 1)
+
+    if start >= total:
+        return 416, b"", None
+
+    body = data[start:end + 1]
+    return 206, body, f"bytes {start}-{end}/{total}"
diff --git a/test_ranges.py b/test_ranges.py
index 419c57d..30248f4 100644
--- a/test_ranges.py
+++ b/test_ranges.py
@@ -11,6 +11,60 @@ class RangesTest(unittest.TestCase):
         self.assertEqual(serve_range(b"abcdef", "bytes=1-3"),
                          (206, b"bcd", "bytes 1-3/6"))
 
+    def test_empty_header(self):
+        self.assertEqual(serve_range(b"abcdef", ""), (200, b"abcdef", None))
+
+    def test_open_ended(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=3-"),
+                         (206, b"def", "bytes 3-5/6"))
+
+    def test_suffix(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=-2"),
+                         (206, b"ef", "bytes 4-5/6"))
+
+    def test_suffix_longer_than_data(self):
+        self.assertEqual(serve_range(b"abc", "bytes=-10"),
+                         (206, b"abc", "bytes 0-2/3"))
+
+    def test_oversized_end_is_clamped(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=4-999"),
+                         (206, b"ef", "bytes 4-5/6"))
+
+    def test_first_byte_only(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=0-0"),
+                         (206, b"a", "bytes 0-0/6"))
+
+    def test_last_byte_only(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=5-5"),
+                         (206, b"f", "bytes 5-5/6"))
+
+    def test_start_past_end_is_unsatisfiable(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=6-"), (416, b"", None))
+
+    def test_zero_suffix_is_unsatisfiable(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=-0"), (416, b"", None))
+
+    def test_reversed_range_is_unsatisfiable(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=4-2"), (416, b"", None))
+
+    def test_empty_data(self):
+        self.assertEqual(serve_range(b"", "bytes=0-"), (416, b"", None))
+
+    def test_multiple_ranges_rejected(self):
+        with self.assertRaises(ValueError):
+            serve_range(b"abcdef", "bytes=0-1,3-4")
+
+    def test_bad_unit_rejected(self):
+        with self.assertRaises(ValueError):
+            serve_range(b"abcdef", "items=0-1")
+
+    def test_malformed_rejected(self):
+        for header in ("bytes=", "bytes=abc", "bytes=1-2-3", "bytes=1-x",
+                       "bytes=-"):
+            with self.subTest(header=header):
+                with self.assertRaises(ValueError):
+                    serve_range(b"abcdef", header)
+
 
 if __name__ == "__main__":
     unittest.main()
