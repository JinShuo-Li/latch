@@ -19,6 +19,39 @@ class FeedTest(unittest.TestCase):
         second, _ = page(ROWS[1:], cursor, 2)
         self.assertEqual([row["id"] for row in first + second], ["a", "b", "c", "d"])
 
+    def test_delete_cursor_record(self):
+        first, cursor = page(ROWS, None, 2)
+        second, _ = page(ROWS[2:], cursor, 2)
+        self.assertEqual([row["id"] for row in first + second], ["a", "b", "c", "d"])
+
+    def test_cursor_is_opaque_key(self):
+        _, cursor = page(ROWS, None, 1)
+        self.assertNotEqual(cursor, "1")
+        with self.assertRaises(ValueError):
+            page(ROWS, "1", 1)
+
+    def test_unsorted_input(self):
+        shuffled = [ROWS[3], ROWS[1], ROWS[2], ROWS[0]]
+        first, cursor = page(shuffled, None, 3)
+        second, end = page(shuffled, cursor, 3)
+        self.assertEqual(first + second, ROWS)
+        self.assertIsNone(end)
+
+    def test_malformed_cursors(self):
+        for cursor in ["", "!!!not base64!!!", "YWJj", "bnVsbA==", "WzFd"]:
+            with self.assertRaises(ValueError):
+                page(ROWS, cursor, 2)
+
+    def test_nonpositive_limits(self):
+        for limit in [0, -1]:
+            with self.assertRaises(ValueError):
+                page(ROWS, None, limit)
+
+    def test_empty_page_has_no_cursor(self):
+        items, cursor = page(ROWS, None, 10)
+        self.assertEqual(items, ROWS)
+        self.assertIsNone(cursor)
+
 
 if __name__ == "__main__":
     unittest.main()
