 """Ascending activity feed pagination."""
 
 import base64
+import binascii
+import bisect
+import json
+
+
+def _encode_cursor(key):
+    payload = json.dumps([key[0], key[1]], separators=(",", ":")).encode("utf-8")
+    return base64.urlsafe_b64encode(payload).decode("ascii")
+
+
+def _decode_cursor(cursor):
+    if cursor is None:
+        return None
+    if not isinstance(cursor, str) or not cursor:
+        raise ValueError("malformed cursor")
+    try:
+        payload = base64.b64decode(cursor.encode("ascii"), altchars=b"-_", validate=True)
+        key = json.loads(payload.decode("utf-8"))
+    except (UnicodeError, ValueError, binascii.Error) as exc:
+        raise ValueError("malformed cursor") from exc
+    if not isinstance(key, list) or len(key) != 2:
+        raise ValueError("malformed cursor")
+    timestamp, record_id = key
+    if isinstance(timestamp, bool) or not isinstance(timestamp, (int, float)):
+        raise ValueError("malformed cursor")
+    if not isinstance(record_id, str):
+        raise ValueError("malformed cursor")
+    return timestamp, record_id
 
 
 def page(records, cursor, limit):
+    if isinstance(limit, bool) or not isinstance(limit, int) or limit <= 0:
+        raise ValueError("limit must be a positive integer")
+
+    after = _decode_cursor(cursor)
+
     ordered = sorted(records, key=lambda row: (row["timestamp"], row["id"]))
-    start = int(base64.urlsafe_b64decode(cursor.encode()).decode()) if cursor else 0
+    keys = [(row["timestamp"], row["id"]) for row in ordered]
+    start = 0 if after is None else bisect.bisect_right(keys, after)
+
     items = ordered[start:start + limit]
     next_cursor = None
-    if start + limit < len(ordered):
-        next_cursor = base64.urlsafe_b64encode(str(start + limit).encode()).decode()
+    if items and start + len(items) < len(ordered):
+        next_cursor = _encode_cursor((items[-1]["timestamp"], items[-1]["id"]))
     return items, next_cursor
diff --git a/test_feed.py b/test_feed.py
