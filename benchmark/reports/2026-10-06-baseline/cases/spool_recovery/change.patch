 """Process JSONL jobs from an append-only spool with a durable byte checkpoint."""
 
 import json
+import os
+import tempfile
 from pathlib import Path
 
 
 def _save_offset(path, offset):
-    Path(path).write_text(str(offset), encoding="ascii")
+    """Persist offset atomically so an interrupted write keeps the old value."""
+    path = Path(path)
+    fd, temp_name = tempfile.mkstemp(
+        dir=str(path.parent), prefix=path.name + ".", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="ascii") as stream:
+            stream.write(str(offset))
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp_name, path)
+    except BaseException:
+        try:
+            os.unlink(temp_name)
+        except OSError:
+            pass
+        raise
+
+
+def _load_offset(checkpoint_path):
+    """Return the saved offset, or 0 when no checkpoint has been committed yet."""
+    try:
+        text = checkpoint_path.read_text(encoding="ascii")
+    except FileNotFoundError:
+        return 0
+    return int(text.strip())
 
 
 def process_spool(spool_path, checkpoint_path, handler):
