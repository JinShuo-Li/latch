diff --git a/stream_records.py b/stream_records.py
index 996a904..ffc7e3c 100644
--- a/stream_records.py
+++ b/stream_records.py
@@ -6,15 +6,18 @@ import json
 def parse_records(chunks):
     """Return JSON values from chunks; accept a final line without a newline."""
     records = []
-    pending = ""
+    pending = b""
     for chunk in chunks:
-        # A network read may end between two bytes of one UTF-8 character.
-        pending += chunk.decode("utf-8", errors="ignore")
-        lines = pending.split("\n")
+        # A network read may end between two bytes of one UTF-8 character, so
+        # buffer raw bytes and decode only whole lines. 0x0a never occurs
+        # inside a multi-byte character, so splitting before decoding never
+        # cuts a character in half.
+        pending += chunk
+        lines = pending.split(b"\n")
         pending = lines.pop()
         for line in lines:
             if line.strip():
-                records.append(json.loads(line))
+                records.append(json.loads(line.decode("utf-8", errors="ignore")))
     if pending.strip():
-        records.append(json.loads(pending))
+        records.append(json.loads(pending.decode("utf-8", errors="ignore")))
     return records
diff --git a/test_stream_records.py b/test_stream_records.py
index 4beaf11..49d20b6 100644
--- a/test_stream_records.py
+++ b/test_stream_records.py
@@ -20,6 +20,26 @@ class StreamRecordsTest(unittest.TestCase):
             [{"name": "中"}],
         )
 
+    def test_utf8_character_split_across_several_reads(self):
+        self.assertEqual(
+            parse_records([b'{"name":"\xf0', b'\x9f', b'\x98', b'\x80"}\n']),
+            [{"name": "😀"}],
+        )
+
+    def test_character_and_line_split_keeps_following_records(self):
+        self.assertEqual(
+            parse_records(
+                [b'{"id":1,"name":"\xe4', b'\xb8\xad"}\n{"id":2,"name":"\xe4\xb8', b'\xad"}\n']
+            ),
+            [{"id": 1, "name": "中"}, {"id": 2, "name": "中"}],
+        )
+
+    def test_final_line_without_newline_after_split_character(self):
+        self.assertEqual(
+            parse_records([b'{"name":"\xc3', b'\xa9"}']),
+            [{"name": "é"}],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
