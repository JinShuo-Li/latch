     db.commit()
-    handler(payload)
     return True
+
+
+def _claim(db, event_id):
+    """Atomically claim event_id, committing the claim so other connections see it.
+
+    The primary key makes the insert the serialization point, so exactly one
+    delivery can own an event. A completed or in-flight event is not claimable.
+    """
+    try:
+        db.execute("INSERT INTO events(id, done) VALUES(?, 0)", (event_id,))
+        db.commit()
+    except sqlite3.IntegrityError:
+        db.rollback()
+        return False
+    return True
+
+
+def _release_claim(db, event_id):
+    """Drop an unfinished claim so a later delivery can retry the event."""
+    db.execute("DELETE FROM events WHERE id=? AND done=0", (event_id,))
+    db.commit()
