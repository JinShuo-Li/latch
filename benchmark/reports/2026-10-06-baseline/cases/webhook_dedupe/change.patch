+import os
 import sqlite3
+import tempfile
+import threading
+import time
 import unittest
 
 from webhook import process_event
@@ -17,5 +21,50 @@ class WebhookTest(unittest.TestCase):
             process_event(db, "id", 1, lambda _: (_ for _ in ()).throw(RuntimeError()))
         self.assertTrue(process_event(db, "id", 1, lambda _: None))
 
+    def test_completed_result_survives_new_connections(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "events.db")
+            first = sqlite3.connect(path); seen = []
+            self.assertTrue(process_event(first, "id", 1, seen.append))
+            first.close()
+            second = sqlite3.connect(path)
+            self.assertFalse(process_event(second, "id", 1, seen.append))
+            self.assertEqual(seen, [1])
+
+    def test_sequential_duplicates_run_handler_once(self):
+        db = sqlite3.connect(":memory:"); seen = []
+        results = [process_event(db, "id", n, seen.append) for n in range(3)]
+        self.assertEqual(results, [True, False, False])
+        self.assertEqual(seen, [0])
+
+    def test_concurrent_deliveries_run_handler_once(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "events.db")
+            sqlite3.connect(path).close()
+            seen = []
+            lock = threading.Lock()
+
+            def handler(payload):
+                with lock:
+                    seen.append(payload)
+                time.sleep(0.05)
+
+            results, start = [], threading.Barrier(2)
+
+            def deliver():
+                conn = sqlite3.connect(path)
+                start.wait()
+                results.append(process_event(conn, "id", 1, handler))
+                conn.close()
+
+            threads = [threading.Thread(target=deliver) for _ in range(2)]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join()
+
+            self.assertEqual(seen, [1])
+            self.assertEqual(sorted(results), [False, True])
+
 
 if __name__ == "__main__": unittest.main()
