+    """Handle event_id at most once and report whether this call handled it.
+
+    Returns True only when this call ran the handler, False when the event was
+    already completed by an earlier delivery.
+    """
+    db.execute(_SCHEMA)
+    db.commit()
+    if not _claim(db, event_id):
         return False
-    db.execute("INSERT INTO events VALUES(?,1)", (event_id,))
+    try:
+        handler(payload)
+    except BaseException:
+        _release_claim(db, event_id)
+        raise
