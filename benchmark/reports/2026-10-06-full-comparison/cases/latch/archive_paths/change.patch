+from pathlib import Path, PurePosixPath, PureWindowsPath
+
+
+def _safe_name(member):
+    """Return the member's relative path, or raise ValueError if unsafe."""
+    name = member.filename
+    normalized = name.replace("\\", "/")
+    posix = PurePosixPath(normalized)
+    if not normalized or posix.is_absolute() or PureWindowsPath(name).drive:
+        raise ValueError(f"unsafe archive entry: {name!r}")
+    if ".." in posix.parts:
+        raise ValueError(f"unsafe archive entry: {name!r}")
+    if stat.S_ISLNK(member.external_attr >> 16):
+        raise ValueError(f"symbolic link archive entry: {name!r}")
+    return name
 
 
