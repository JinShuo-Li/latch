 """Task graph execution; tasks maps names to dependency lists."""
 
 
+def _resolve_order(tasks):
+    """Validate the graph and return a dependency-safe declaration order."""
+    dependencies = {
+        name: list(dict.fromkeys(deps)) for name, deps in tasks.items()
+    }
+    for name, deps in dependencies.items():
+        for dependency in deps:
+            if dependency not in dependencies:
+                raise ValueError(
+                    "unknown dependency %r required by %r" % (dependency, name)
+                )
+
+    dependents = {name: [] for name in dependencies}
+    pending = {}
+    for name, deps in dependencies.items():
+        pending[name] = len(deps)
+        for dependency in deps:
+            dependents[dependency].append(name)
+
+    order = list(dependencies)
+    scheduled = set()
+    resolved = []
+    while True:
+        for name in order:
+            if name not in scheduled and pending[name] == 0:
+                break
+        else:
+            break
+        scheduled.add(name)
+        resolved.append(name)
+        for dependent in dependents[name]:
+            pending[dependent] -= 1
+
+    if len(resolved) != len(order):
+        raise ValueError("dependency cycle among tasks: %s" % sorted(set(order) - scheduled))
+
+    return resolved
+
