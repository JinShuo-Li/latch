diff --git a/ranges.py b/ranges.py
index 2ccbb75..d2a24d2 100644
--- a/ranges.py
+++ b/ranges.py
@@ -2,12 +2,44 @@
 
 
 def serve_range(data, header):
+    """Serve a single HTTP byte range over ``data``.
+
+    Returns ``(status, body, content_range)``. Raises ``ValueError`` when the
+    ``Range`` header is malformed or requests more than one range.
+    """
+    size = len(data)
     if not header:
         return 200, data, None
+
     if not header.startswith("bytes="):
+        raise ValueError("invalid range unit")
+
+    spec = header[6:]
+    if not spec or "," in spec or spec.count("-") != 1:
+        raise ValueError("invalid range")
+
+    first, last = spec.split("-")
+    if first and not first.isdigit():
+        raise ValueError("invalid range")
+    if last and not last.isdigit():
         raise ValueError("invalid range")
-    start, end = header[6:].split("-", 1)
-    start = int(start or 0)
-    end = int(end or len(data))
-    body = data[start:end]
-    return 206, body, f"bytes {start}-{end}/{len(data)}"
+
+    if not first:
+        # Suffix range: the final N bytes.
+        if not last:
+            raise ValueError("invalid range")
+        length = int(last)
+        if length == 0 or size == 0:
+            return 416, b"", f"bytes */{size}"
+        start = max(0, size - length)
+        end = size - 1
+    else:
+        start = int(first)
+        if start >= size:
+            return 416, b"", f"bytes */{size}"
+        end = int(last) if last else size - 1
+        if end < start:
+            raise ValueError("invalid range")
+        end = min(end, size - 1)
+
+    return 206, data[start:end + 1], f"bytes {start}-{end}/{size}"
diff --git a/test_ranges.py b/test_ranges.py
index 419c57d..88d3a2c 100644
--- a/test_ranges.py
+++ b/test_ranges.py
@@ -11,6 +11,40 @@ class RangesTest(unittest.TestCase):
         self.assertEqual(serve_range(b"abcdef", "bytes=1-3"),
                          (206, b"bcd", "bytes 1-3/6"))
 
+    def test_open_ended(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=2-"),
+                         (206, b"cdef", "bytes 2-5/6"))
+
+    def test_suffix(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=-2"),
+                         (206, b"ef", "bytes 4-5/6"))
+
+    def test_suffix_longer_than_body(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=-100"),
+                         (206, b"abcdef", "bytes 0-5/6"))
+
+    def test_oversized_end_is_clamped(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=0-100"),
+                         (206, b"abcdef", "bytes 0-5/6"))
+
+    def test_unsatisfiable_start(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=6-"),
+                         (416, b"", "bytes */6"))
+
+    def test_unsatisfiable_suffix_zero(self):
+        self.assertEqual(serve_range(b"abcdef", "bytes=-0"),
+                         (416, b"", "bytes */6"))
+
+    def test_malformed(self):
+        for header in ("bytes=", "bytes=-", "bytes=a-b", "bytes=1-2-3",
+                       "items=1-2", "bytes=3-1"):
+            with self.assertRaises(ValueError, msg=header):
+                serve_range(b"abcdef", header)
+
+    def test_multiple_ranges_rejected(self):
+        with self.assertRaises(ValueError):
+            serve_range(b"abcdef", "bytes=0-1,3-4")
+
 
 if __name__ == "__main__":
     unittest.main()
