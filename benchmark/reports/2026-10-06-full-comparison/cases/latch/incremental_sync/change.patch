 """Incremental directory mirror."""
 
+import hashlib
 import json
 import shutil
 from pathlib import Path
 
+MANIFEST_NAME = ".manifest.json"
+_CHUNK_SIZE = 65536
+
+
+def _digest(path):
+    """Return the SHA-256 digest of the file at *path*."""
+    hasher = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(_CHUNK_SIZE), b""):
+            hasher.update(chunk)
+    return hasher.hexdigest()
+
+
+def _scan_source(source):
+    """Hash every regular file below *source*, rejecting symlinks."""
+    current = {}
+    for path in source.rglob("*"):
+        if path.is_symlink():
+            raise ValueError(f"symlink not allowed in source: {path}")
+        if path.is_file():
+            current[path.relative_to(source).as_posix()] = _digest(path)
+    return current
+
 
 def sync_tree(source, destination):
     source, destination = Path(source), Path(destination)
     destination.mkdir(parents=True, exist_ok=True)
-    manifest = destination / ".manifest.json"
+    manifest = destination / MANIFEST_NAME
     previous = json.loads(manifest.read_text()) if manifest.exists() else {}
-    current = {}
-    for path in source.rglob("*"):
-        if path.is_file():
-            relative = path.relative_to(source).as_posix()
-            current[relative] = str(path.stat().st_size)
+
+    current = _scan_source(source)
+
+    # Copy phase: new files and files whose content changed.
+    for relative, digest in current.items():
+        if previous.get(relative) != digest:
             target = destination / relative
-            if relative not in previous:
-                target.parent.mkdir(parents=True, exist_ok=True)
-                shutil.copy2(path, target)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source / relative, target)
+
+    # Delete phase: drop destination files that no longer exist in source.
+    stale = []
+    for path in destination.rglob("*"):
+        if path.is_symlink() or not path.is_file():
+            continue
+        relative = path.relative_to(destination).as_posix()
+        if relative != MANIFEST_NAME and relative not in current:
+            stale.append(path)
+    for path in stale:
+        path.unlink()
+
+    # Remove directories left empty by the delete phase (deepest first).
+    for path in sorted(destination.rglob("*"), key=lambda item: len(item.parts), reverse=True):
+        if path.is_dir() and not path.is_symlink() and not any(path.iterdir()):
+            path.rmdir()
+
     manifest.write_text(json.dumps(current))
     return current
