 """Ascending activity feed pagination."""
 
 import base64
+import binascii
+import json
+
+
+def _key(row):
+    return (row["timestamp"], row["id"])
+
+
+def _encode(key):
+    raw = json.dumps(list(key), separators=(",", ":")).encode()
+    return base64.urlsafe_b64encode(raw).decode()
+
+
+def _decode(cursor):
+    if not isinstance(cursor, str):
+        raise ValueError("malformed cursor")
+    try:
+        raw = base64.urlsafe_b64decode(cursor.encode()).decode()
+        key = json.loads(raw)
+    except (binascii.Error, UnicodeDecodeError, ValueError, TypeError):
+        raise ValueError("malformed cursor")
+    if not isinstance(key, list) or len(key) != 2:
+        raise ValueError("malformed cursor")
+    return key[0], key[1]
 
 
 def page(records, cursor, limit):
-    ordered = sorted(records, key=lambda row: (row["timestamp"], row["id"]))
-    start = int(base64.urlsafe_b64decode(cursor.encode()).decode()) if cursor else 0
-    items = ordered[start:start + limit]
+    if isinstance(limit, bool) or not isinstance(limit, int) or limit <= 0:
+        raise ValueError("limit must be a positive integer")
+    ordered = sorted(records, key=_key)
+    if cursor is None:
+        remaining = ordered
+    else:
+        last = _decode(cursor)
+        remaining = [row for row in ordered if _key(row) > last]
+    items = remaining[:limit]
     next_cursor = None
-    if start + limit < len(ordered):
-        next_cursor = base64.urlsafe_b64encode(str(start + limit).encode()).decode()
+    if len(remaining) > limit:
+        next_cursor = _encode(_key(items[-1]))
     return items, next_cursor
