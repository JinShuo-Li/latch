+    def test_cursor_is_opaque_and_stable(self):
+        _, cursor = page(ROWS, None, 2)
+        self.assertNotEqual(cursor, "2")
+        self.assertEqual(page(ROWS, cursor, 2)[0], ROWS[2:])
+
+    def test_ties_split_on_id(self):
+        first, cursor = page(ROWS, None, 1)
+        second, _ = page(ROWS, cursor, 1)
+        self.assertEqual([row["id"] for row in first + second], ["a", "b"])
+
+    def test_malformed_cursor_rejected(self):
+        for cursor in ("not-base64!", base64.urlsafe_b64encode(b"junk").decode(),
+                       base64.urlsafe_b64encode(b'{"t": 1}').decode()):
+            with self.assertRaises(ValueError):
+                page(ROWS, cursor, 2)
+
+    def test_nonpositive_limit_rejected(self):
+        for limit in (0, -1):
+            with self.assertRaises(ValueError):
+                page(ROWS, None, limit)
+
 
 if __name__ == "__main__":
