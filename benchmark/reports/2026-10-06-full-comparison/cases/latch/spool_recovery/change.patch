 def _save_offset(path, offset):
-    Path(path).write_text(str(offset), encoding="ascii")
+    """Persist offset atomically so an interrupted write cannot corrupt it."""
+    path = Path(path)
+    fd, temp_path = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".", suffix=".tmp")
