diff --git a/stream_records.py b/stream_records.py
index 996a904..bc16374 100644
--- a/stream_records.py
+++ b/stream_records.py
@@ -1,5 +1,6 @@
 """Parse newline-delimited JSON events from arbitrary network byte chunks."""
 
+import codecs
 import json
 
 
@@ -7,14 +8,18 @@ def parse_records(chunks):
     """Return JSON values from chunks; accept a final line without a newline."""
     records = []
     pending = ""
+    # A network read may end between two bytes of one UTF-8 character, so the
+    # decoder must hold those bytes back until the rest of the character
+    # arrives instead of discarding them.
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="ignore")
     for chunk in chunks:
-        # A network read may end between two bytes of one UTF-8 character.
-        pending += chunk.decode("utf-8", errors="ignore")
+        pending += decoder.decode(chunk)
         lines = pending.split("\n")
         pending = lines.pop()
         for line in lines:
             if line.strip():
                 records.append(json.loads(line))
+    pending += decoder.decode(b"", final=True)
     if pending.strip():
         records.append(json.loads(pending))
     return records
diff --git a/test_stream_records.py b/test_stream_records.py
index 4beaf11..923d69b 100644
--- a/test_stream_records.py
+++ b/test_stream_records.py
@@ -20,6 +20,28 @@ class StreamRecordsTest(unittest.TestCase):
             [{"name": "中"}],
         )
 
+    def test_utf8_character_split_across_many_reads(self):
+        payload = '{"name":"中文🙂","n":1}\n{"name":"ok"}\n'.encode("utf-8")
+        chunks = [payload[i : i + 1] for i in range(len(payload))]
+        self.assertEqual(
+            parse_records(chunks),
+            [{"name": "中文🙂", "n": 1}, {"name": "ok"}],
+        )
+
+    def test_dangling_partial_character_at_end_of_stream(self):
+        # Bytes held back for an unfinished character must not swallow the
+        # records that were already complete.
+        self.assertEqual(
+            parse_records([b'{"id":1}\n', b'{"id":2}\n\xe4\xb8']),
+            [{"id": 1}, {"id": 2}],
+        )
+
+    def test_trailing_line_without_newline_split_mid_character(self):
+        self.assertEqual(
+            parse_records([b'{"name":"\xe4\xb8', b'\xad"}']),
+            [{"name": "中"}],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
