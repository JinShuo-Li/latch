+import os
 import sqlite3
+import tempfile
+import threading
 import unittest
 
 from webhook import process_event
@@ -17,5 +20,39 @@ class WebhookTest(unittest.TestCase):
             process_event(db, "id", 1, lambda _: (_ for _ in ()).throw(RuntimeError()))
         self.assertTrue(process_event(db, "id", 1, lambda _: None))
 
+    def test_completion_survives_new_connection(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "events.db")
+            first, second = sqlite3.connect(path), sqlite3.connect(path)
+            seen = []
+            self.assertTrue(process_event(first, "id", 1, seen.append))
+            self.assertFalse(process_event(second, "id", 1, seen.append))
+            self.assertEqual(seen, [1])
+
+    def test_concurrent_duplicate_runs_handler_once(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "events.db")
+            seen, results, errors = [], [], []
+            barrier = threading.Barrier(2)
+
+            def deliver():
+                conn = sqlite3.connect(path, timeout=30)
+                try:
+                    barrier.wait()
+                    results.append(process_event(conn, "id", 1, seen.append))
+                except BaseException as exc:  # pragma: no cover - diagnostics
+                    errors.append(exc)
+                finally:
+                    conn.close()
+
+            threads = [threading.Thread(target=deliver) for _ in range(2)]
+            for thread in threads:
+                thread.start()
+            for thread in threads:
+                thread.join()
+            self.assertEqual(errors, [])
+            self.assertEqual(seen, [1])
+            self.assertEqual(sorted(results), [False, True])
+
 
 if __name__ == "__main__": unittest.main()
