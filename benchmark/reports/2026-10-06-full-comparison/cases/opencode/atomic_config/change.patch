-    path.write_text(json.dumps(data), encoding="utf-8")
+        try:
+            existing = path.read_text(encoding="utf-8")
+            _parse_config(existing)
+        except (OSError, ValueError):
+            # The live file is missing/corrupt: keep any existing good backup.
+            pass
+        else:
+            # Preserve the previous *valid* configuration as the backup.
+            _atomic_write_text(_backup_path(path), existing)
+
+    _atomic_write_text(path, serialized)
 
 
 def read_config(path):
-    return json.loads(Path(path).read_text(encoding="utf-8"))
+    """Read the configuration from *path*.
+
+    If the live file is missing or corrupt, fall back to a valid backup. If
+    neither copy is usable, raise an error.
+    """
+    path = Path(path)
+    backup = _backup_path(path)
+
+    live_error = None
+    try:
+        return _parse_config(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        live_error = exc
+
+    backup_error = None
+    try:
+        return _parse_config(backup.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        backup_error = exc
+
+    if isinstance(live_error, FileNotFoundError) and isinstance(
+        backup_error, FileNotFoundError
+    ):
+        raise FileNotFoundError(
+            "no configuration file found at {!s} or its backup".format(path)
+        )
+
+    raise ValueError(
+        "no valid configuration at {!s} (backup also unusable)".format(path)
+    ) from live_error
