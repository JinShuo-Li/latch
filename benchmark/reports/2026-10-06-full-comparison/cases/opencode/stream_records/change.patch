diff --git a/stream_records.py b/stream_records.py
index 996a904..cea5b4f 100644
--- a/stream_records.py
+++ b/stream_records.py
@@ -1,5 +1,6 @@
 """Parse newline-delimited JSON events from arbitrary network byte chunks."""
 
+import codecs
 import json
 
 
@@ -7,14 +8,21 @@ def parse_records(chunks):
     """Return JSON values from chunks; accept a final line without a newline."""
     records = []
     pending = ""
+    # A network read may end between two bytes of one UTF-8 character, so
+    # decoding each chunk independently would corrupt or drop that character.
+    # An incremental decoder buffers the incomplete byte sequence until the
+    # bytes that complete it arrive in a later chunk.
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="ignore")
     for chunk in chunks:
-        # A network read may end between two bytes of one UTF-8 character.
-        pending += chunk.decode("utf-8", errors="ignore")
+        pending += decoder.decode(chunk)
         lines = pending.split("\n")
         pending = lines.pop()
         for line in lines:
             if line.strip():
                 records.append(json.loads(line))
+    # Flush any bytes still buffered so a split character at end-of-stream is
+    # not silently discarded.
+    pending += decoder.decode(b"", final=True)
     if pending.strip():
         records.append(json.loads(pending))
     return records
diff --git a/test_stream_records.py b/test_stream_records.py
index 4beaf11..ac2dbdb 100644
--- a/test_stream_records.py
+++ b/test_stream_records.py
@@ -20,6 +20,40 @@ class StreamRecordsTest(unittest.TestCase):
             [{"name": "中"}],
         )
 
+    def test_utf8_character_split_across_three_reads(self):
+        self.assertEqual(
+            parse_records([b'{"name":"\xe4', b'\xb8', b'\xad"}\n']),
+            [{"name": "中"}],
+        )
+
+    def test_all_two_way_byte_splits_preserve_records(self):
+        stream = '{"id":1}\n{"name":"日本語"}\n{"id":2}\n'.encode("utf-8")
+        expected = [{"id": 1}, {"name": "日本語"}, {"id": 2}]
+        for i in range(len(stream) + 1):
+            with self.subTest(split=i):
+                self.assertEqual(
+                    parse_records([stream[:i], stream[i:]]), expected
+                )
+
+    def test_byte_by_byte_feed_preserves_records(self):
+        stream = '{"id":1}\n{"name":"café"}\n'.encode("utf-8")
+        chunks = [bytes([b]) for b in stream]
+        self.assertEqual(
+            parse_records(chunks), [{"id": 1}, {"name": "café"}]
+        )
+
+    def test_final_record_without_trailing_newline(self):
+        self.assertEqual(
+            parse_records([b'{"id":1}\n{"name":"\xe4\xb8', b'\xad"}']),
+            [{"id": 1}, {"name": "中"}],
+        )
+
+    def test_blank_lines_are_skipped(self):
+        self.assertEqual(
+            parse_records([b'\n{"id":1}\n\n', b'{"id":2}\n']),
+            [{"id": 1}, {"id": 2}],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
