diff --git a/stream_records.py b/stream_records.py
index 996a904..3746bee 100644
--- a/stream_records.py
+++ b/stream_records.py
@@ -6,15 +6,19 @@ import json
 def parse_records(chunks):
     """Return JSON values from chunks; accept a final line without a newline."""
     records = []
-    pending = ""
+    pending = b""
     for chunk in chunks:
-        # A network read may end between two bytes of one UTF-8 character.
-        pending += chunk.decode("utf-8", errors="ignore")
-        lines = pending.split("\n")
+        # Buffer raw bytes and only split on newlines: a network read may end
+        # between two bytes of one UTF-8 character, and decoding (or splitting
+        # text) before the character is complete would corrupt or drop data.
+        # "\n" (0x0A) never occurs inside a multi-byte UTF-8 sequence, so
+        # splitting the byte buffer on b"\n" is safe.
+        pending += chunk
+        lines = pending.split(b"\n")
         pending = lines.pop()
         for line in lines:
             if line.strip():
-                records.append(json.loads(line))
+                records.append(json.loads(line.decode("utf-8")))
     if pending.strip():
-        records.append(json.loads(pending))
+        records.append(json.loads(pending.decode("utf-8")))
     return records
diff --git a/test_stream_records.py b/test_stream_records.py
index 4beaf11..46c8e21 100644
--- a/test_stream_records.py
+++ b/test_stream_records.py
@@ -20,6 +20,38 @@ class StreamRecordsTest(unittest.TestCase):
             [{"name": "中"}],
         )
 
+    def test_utf8_character_split_across_three_reads(self):
+        # 中 is E4 B8 AD; each byte arrives in its own chunk.
+        self.assertEqual(
+            parse_records([b'{"name":"\xe4', b'\xb8', b'\xad"}\n']),
+            [{"name": "中"}],
+        )
+
+    def test_records_lost_after_split_character(self):
+        # The record containing a split character must not swallow the next one.
+        self.assertEqual(
+            parse_records([b'{"name":"\xe4\xb8\xad"}\n{"id":2}', b'\n']),
+            [{"name": "中"}, {"id": 2}],
+        )
+
+    def test_split_character_in_final_line_without_newline(self):
+        self.assertEqual(
+            parse_records([b'{"name":"\xe4', b'\xb8\xad"}']),
+            [{"name": "中"}],
+        )
+
+    def test_split_character_per_chunk_for_every_record(self):
+        chunks = [
+            b'{"name":"\xe4',
+            b'\xb8\xad"}\n{"name":"\xe6',
+            b'\x97\xa5"}\n{"name":"\xf0\x9f',
+            b'\x98\x80"}\n',
+        ]
+        self.assertEqual(
+            parse_records(chunks),
+            [{"name": "中"}, {"name": "日"}, {"name": "😀"}],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
