 """Process JSONL jobs from an append-only spool with a durable byte checkpoint."""
 
 import json
+import os
+import tempfile
 from pathlib import Path
 
 
 def _save_offset(path, offset):
-    Path(path).write_text(str(offset), encoding="ascii")
+    """Commit the checkpoint atomically so a crash can never leave it half-written."""
+    path = Path(path)
+    handle, temp_name = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".", suffix=".tmp")
+    try:
+        with os.fdopen(handle, "w", encoding="ascii") as stream:
+            stream.write(str(offset))
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp_name, path)
+    except BaseException:
+        try:
+            os.unlink(temp_name)
+        except OSError:
+            pass
+        raise
 
 
